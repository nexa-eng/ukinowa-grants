# うきのわ 助成金カレンダー の設定。GitHub Actions のシークレットと同じ内容をここで管理する。
# 登録: gh secret set -f .env    ローカル実行: set -a; . ./.env; set +a; python -m grants.run --llm --no-mail
ANTHROPIC_API_KEY=sk-ant-ここにClaudeのAPIキー
